# NetLab AI settings. Copy this file to .env. It is never sent to the browser.
#
# FREE (default): install Ollama from https://ollama.com, then run once:
#     ollama pull llama3.2
# NetLab finds it automatically - nothing to fill in here.
#
# PAID (optional): put a real Claude API key here to use Claude instead.
ANTHROPIC_API_KEY=
#
# Optional settings
# AI_PROVIDER=auto            # auto | ollama | claude
# OLLAMA_MODEL=llama3.2       # any model you have pulled, e.g. qwen2.5:7b
# OLLAMA_URL=http://127.0.0.1:11434
# NETLAB_MODEL=claude-opus-5-5
# PORT=5050
# HOST=127.0.0.1
